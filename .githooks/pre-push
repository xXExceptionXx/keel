#!/bin/bash
# Before a push: the leak check over every commit that is new to the remote, on every system. CI covers Linux and
# macOS; for feedback before the push, opt in to the tests with the macOS system python 3.9 and bash 3.2:
#   git config keel.prePushTests true
# Enable once per clone: git config core.hooksPath .githooks
# Skip a single push:    git push --no-verify

cd "$(git rev-parse --show-toplevel)" || exit 1

zero=0000000000000000000000000000000000000000
while read -r _ local_sha _ _; do
  [ "$local_sha" = "$zero" ] && continue
  python3 tests/leak_check.py --range "$local_sha --not --remotes" || exit 1
done

[ "$(git config --bool keel.prePushTests)" = true ] && [ "$(uname -s)" = Darwin ] || exit 0

shim=$(mktemp -d)
trap 'rm -rf "$shim"' EXIT
ln -s /bin/bash "$shim/bash"
ln -s /usr/bin/python3 "$shim/python3"
export PATH="$shim:$PATH"
export KEEL_TEST_BASH=/bin/bash

echo "pre-push: tests with $(python3 --version), bash ${BASH_VERSION%%(*} (skip with --no-verify)"
python3 tests/run.py
