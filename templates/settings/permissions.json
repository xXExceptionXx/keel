{
  "permissions": {
    "allow": [
      "Read(~/.keel-metrics/**)",
      "Read(~/.claude/plugins/**)",
      "WebSearch",
      "WebFetch"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push --force-with-lease*)",
      "Bash(git branch -D*)",
      "Bash(git reset --hard*)",
      "Bash(git filter-branch*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(sudo *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./.env)",
      "Edit(./.env.*)"
    ]
  }
}
